generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// 1. A IDENTIDADE (Quem faz o login)
model User {
  id       String @id @default(uuid())
  name     String
  email    String @unique
  password String
  phone    String
  role     Role   @default(CLIENT)

  refreshToken String?

  asaasCustomerId String? @unique
  cpfCnpj         String? @unique

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  isActive   Boolean   @default(true)
  disabledAt DateTime? // Corrigido de dateTime? para DateTime?

  companies         Company[]
  appointments      Appointment[]
  financialProfiles FinancialProfile[]
  transactions      Transaction[]
}

enum Role {
  CLIENT
  PROVIDER
  COMPANY_OWNER
  EMPLOYEE
  ADMIN
  SUPER_ADMIN
}

// 2. O NEGÓCIO (A Barbearia/Estúdio/Empresa)
model Company {
  id           String    @id @default(uuid())
  userId       String
  businessName String
  slug         String    @unique
  whatsapp     String? // Adicionado de volta o número público
  chairsCount  Int       @default(1)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  isActive     Boolean   @default(true)
  disabledAt   DateTime? // Corrigido de dateTime? para DateTime?

  providerType String
  district     String
  street       String
  city         String
  state        String
  zipCode      String
  number       String

  logoPhoto   String?
  bannerPhoto String?

  timezone String @default("America/Sao_Paulo")

  platformCustomerId String? // ID do cliente na conta mestre do Asaas para emissão de NFS-e

  financialProfileId String?
  financialProfile   FinancialProfile? @relation(fields: [financialProfileId], references: [id])

  owner              User                @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  services           Service[]
  appointments       Appointment[]
  serviceGroups      ServiceGroup[]
  workingHours       WorkingHour[]
  scheduleExceptions ScheduleException[]
  invoices           PlatformInvoice[]

  @@index([userId])
}

// Grupo de serviços
model ServiceGroup {
  id         String    @id @default(uuid())
  name       String
  capacity   Int       @default(1)
  companyId  String
  isActive   Boolean   @default(true)
  disabledAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  services Service[]

  @@index([companyId])
}

// 3. OS SERVIÇOS
model Service {
  id                 String    @id @default(uuid())
  companyId          String
  name               String
  description        String?
  durationMinutes    Int
  totalPrice         Decimal   @db.Decimal(10, 2)
  downPaymentPercent Int       @default(50)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  isActive           Boolean   @default(true)
  disabledAt         DateTime?
  serviceGroupId     String

  serviceGroup ServiceGroup  @relation(fields: [serviceGroupId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  appointments Appointment[]

  @@index([companyId])
  @@index([serviceGroupId])
}

// 4. OS AGENDAMENTOS
model Appointment {
  id                 String     @id @default(uuid())
  companyId          String
  serviceId          String
  clientId           String
  appointmentDate    DateTime
  appointmentEndDate DateTime
  status             ApptStatus @default(PENDING_PAYMENT)
  expiresAt          DateTime?
  pixTxId            String? // transaction id do pix
  servicePrice          Decimal    @db.Decimal(10, 2)
  downPaymentAmount     Decimal    @db.Decimal(10, 2)
  platformFeeAmount     Decimal    @db.Decimal(10, 2)
  retainedDepositAmount Decimal?   @db.Decimal(10, 2)
  completedAt           DateTime?  // Preenchido quando o status é atualizado para COMPLETED
  platformInvoiceId     String?    // ID da NFS-e consolidada que cobriu a comissão
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt // Adicionado para rastrear mudanças de status
  isActive              Boolean    @default(true)
  disabledAt            DateTime? // Corrigido de dateTime? para DateTime?
  disabledBy            String?

  company         Company          @relation(fields: [companyId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  service         Service          @relation(fields: [serviceId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  client          User             @relation(fields: [clientId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  transactions    Transaction[]
  platformInvoice PlatformInvoice? @relation(fields: [platformInvoiceId], references: [id])

  @@index([companyId])
  @@index([companyId, platformInvoiceId])
  @@index([clientId])
  @@index([serviceId])
  @@index([companyId, appointmentDate])
  @@index([appointmentDate, appointmentEndDate])
  @@index([status])
  @@index([expiresAt])
}

enum ApptStatus {
  PENDING_PAYMENT
  CONFIRMED
  COMPLETED
  CANCELED
  NO_SHOW
}

// 5. AGENDA SEMANAL
model WorkingHour {
  id             String  @id @default(uuid())
  companyId      String
  dayOfWeek      Int // 0 = Domingo, 1 = Segunda, 2 = Terça...
  startTime      String // "09:00"
  endTime        String // "18:00"
  lunchStartTime String?
  lunchEndTime   String?
  isClosed       Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([companyId, dayOfWeek])
}

// 6. EXCEÇÕES E FERIADOS
model ScheduleException {
  id        String   @id @default(uuid())
  companyId String
  date      DateTime
  isClosed  Boolean  @default(true)

  startTime   String?
  endTime     String?
  description String?

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  isActive   Boolean   @default(true)
  disabledAt DateTime?

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([companyId, date])
}

model FinancialProfile {
  id String @id @default(cuid())

  // Dados Básicos da Subconta
  name        String
  email       String
  cpfCnpj     String    @unique
  birthDate   DateTime? // Obrigatório apenas para PF (Pessoa Física)
  companyType String? // MEI, LIMITED, INDIVIDUAL, ASSOCIATION (Apenas para PJ)

  // Contato e Faturamento
  mobilePhone String
  incomeValue Decimal @db.Decimal(10, 2)

  // Endereço
  address       String // Logradouro
  addressNumber String
  province      String // Bairro
  postalCode    String

  // Retorno do Asaas
  walletId    String  @unique // ID da carteira gerada no Asaas
  pixAddressKey     String? // Chave PIX
  pixAddressKeyType String? // Tipo da chave PIX (CPF, EMAIL, PHONE, RANDOM)

  asaasApiKey String? // Chave de API da subconta (útil para operações futuras)

  // Relacionamentos da sua Arquitetura
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  companies    Company[]
  transactions Transaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  isActive   Boolean   @default(true)
  disabledAt DateTime?

  @@index([userId])
}

// Toda lógica de transações
enum TransactionStatus {
  PENDING
  CONFIRMED
  OVERDUE
  CANCELED
  REFUNDED
}

enum TransactionType {
  DEPOSIT // Quando o cliente paga o Pix do sinal
  WITHDRAWAL // Quando o barbeiro sacar o dinheiro
}

enum BillingType {
  PIX
  //CREDIT_CARD
  //DEBIT_CARD
  //BOLETO
}

model Transaction {
  id String @id @default(uuid())

  // A ponte de ligação com o Asaas (Fundamental para o Webhook achar depois)
  asaasPaymentId String? @unique

  // Controle de Valores
  totalValue          Decimal @db.Decimal(10, 2) // Valor total que o cliente pagou (ex: 12.00)
  netValue            Decimal @db.Decimal(10, 2) // O que realmente vai pro barbeiro (ex: 9.01)
  platformFee         Decimal @db.Decimal(10, 2) // A sua parte da grana (ex: 2.00)
  asaasFee            Decimal @db.Decimal(10, 2) // Parte do asaas (ex: 0,99)
  platformAbsorbedFee Decimal @default(0) @db.Decimal(10, 2) // Parcela da tarifa Asaas absorvida pela plataforma (tarifaReal - parte do barbeiro)

  // Status e Tipo
  status         TransactionStatus @default(PENDING)
  type           TransactionType   @default(DEPOSIT)
  billingType    BillingType       @default(PIX)
  paidByPlatform Boolean           @default(false) // Indica se a taxa de transferencia de saque foi custeada pela plataforma (Regra N5)

  // Relacionamentos (Quem pagou e quem recebeu)
  customerId String? // ID do cliente que agendou/pagou se DEPOSIT
  customer   User?   @relation(fields: [customerId], references: [id])

  barberWalletId   String // A carteira do Asaas que recebeu o split
  financialProfile FinancialProfile @relation(fields: [barberWalletId], references: [walletId])

  // Relacionamento com o Agendamento
  appointmentId String?      @unique
  appointment   Appointment? @relation(fields: [appointmentId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([barberWalletId])
  @@index([customerId])
  @@index([status])
  @@map("transactions")
}

model WebhookEvent {
  id          String   @id @default(uuid())
  eventId     String   @unique
  event       String
  paymentId   String?
  payload     Json?
  processedAt DateTime @default(now())

  @@map("webhook_events")
}

enum PlatformInvoiceStatus {
  SCHEDULED
  SYNCHRONIZED
  AUTHORIZED
  PROCESSING_CANCELLATION
  CANCELED
  CANCELLATION_DENIED
  ERROR
}

model PlatformInvoice {
  id                String                @id @default(uuid())
  companyId         String
  company           Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)

  periodMonth       Int                   // 1 a 12
  periodYear        Int                   // Ex: 2026
  periodStart       DateTime              // Início da competência (UTC)
  periodEnd         DateTime              // Fim da competência (UTC)

  grossAmount       Decimal               @db.Decimal(10, 2) // Valor bruto acumulado das taxas da plataforma
  appointmentsCount Int                   // Total de agendamentos faturados nesta nota

  asaasInvoiceId    String?               @unique // ID retornado pelo Asaas (ex: inv_000000123)
  status            PlatformInvoiceStatus @default(SCHEDULED)

  invoiceNumber     String?               // Número da NFS-e municipal
  pdfUrl            String?               // URL do PDF da nota no Asaas
  xmlUrl            String?               // URL do XML da nota no Asaas
  errorMessage      String?               // Detalhes do erro da prefeitura caso status = ERROR

  effectiveDate     DateTime              // Data agendada da emissão
  authorizedAt      DateTime?             // Data da autorização municipal

  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  appointments      Appointment[]

  @@unique([companyId, periodYear, periodMonth])
  @@index([companyId])
  @@index([status])
  @@index([periodYear, periodMonth])
  @@map("platform_invoices")
}

