# ==========================================
# SinalizeGO API - Environment Variables
# ==========================================

# ------------------------------------------
# 1. Server & Environment
# ------------------------------------------
PORT=3000
NODE_ENV=development

# ------------------------------------------
# 2. Database Connection (PostgreSQL 16)
# ------------------------------------------
# Development local:
DATABASE_URL="postgresql://postgres:password123@localhost:5432/sinalizego_dev?schema=public"
DIRECT_URL="postgresql://postgres:password123@localhost:5432/sinalizego_dev?schema=public"

# Production/Staging VM example:
# DATABASE_URL="postgresql://sinalize_user:senha_segura@<vm_ip>:5432/sinalizego_prod?schema=public&sslmode=prefer"
# DIRECT_URL="postgresql://sinalize_user:senha_segura@<vm_ip>:5432/sinalizego_prod?schema=public&sslmode=prefer"

# Pool de conexões Prisma/pg.Pool (Frugal DBA):
DB_POOL_MAX=20
DB_POOL_IDLE_TIMEOUT=30000
DB_POOL_CONN_TIMEOUT=5000

# ------------------------------------------
# 3. Authentication & Encryption Secrets
# ------------------------------------------
# Secret key for access token signing (min 32 chars recommended)
JWT_SECRET="super_secret_jwt_access_key_change_in_production"
# Secret key for refresh token signing (min 32 chars recommended)
JWT_REFRESH_SECRET="super_secret_jwt_refresh_key_change_in_production"
# Secret key for AES-256-GCM encryption at rest for subaccount API keys (min 32 chars)
ENCRYPTION_SECRET="super_secret_encryption_key_32_characters_minimum"

# ------------------------------------------
# 4. CORS & Frontend Integration
# ------------------------------------------
# Base URL for frontend client (used in password reset links)
# Production: https://app.sinalizego.com.br | Staging: https://app-staging.sinalizego.com.br | Dev: http://localhost:5173
FRONTEND_URL="http://localhost:5173"

# Allowed origins for CORS (comma-separated list, e.g. https://app.sinalizego.com.br,https://sinalizego.com.br)
# In production, wildcards (*), localhost and http:// are strictly forbidden (fail-closed)
CORS_ORIGINS="http://localhost:3000,http://localhost:5173"

# ------------------------------------------
# 5. API Documentation (Swagger)
# ------------------------------------------
# Set to 'true' if Swagger should be enabled in production environments (default is disabled in prod)
ENABLE_SWAGGER_IN_PROD=false

# ------------------------------------------
# 6. Asaas Payment Gateway Integration
# ------------------------------------------
# Asaas API Base URL:
# Sandbox: https://sandbox.asaas.com/api/v3
# Production: https://api.asaas.com/v3
ASAAS_API_URL="https://sandbox.asaas.com/api/v3"
# Master API Key from Asaas account
ASAAS_API_KEY="$aact_YTU5YTE0M2NmN..."
# Webhook notification callback canonical URL for payment events
# Canonical: https://api.sinalizego.com.br/webhooks/asaas (or tunnel for local dev)
ASAAS_WEBHOOK_URL="https://api.sinalizego.com.br/webhooks/asaas"
# Notification email registered for Asaas webhook events
ASAAS_WEBHOOK_EMAIL="notificacoes@sinalizego.com.br"
# Secret authentication token validated via Asaas-Access-Token header in webhook requests
ASAAS_WEBHOOK_TOKEN="asaas_webhook_secret_token_123456"

# ------------------------------------------
# 7. Cloudinary Storage (Image Uploads)
# ------------------------------------------
CLOUDINARY_CLOUD_NAME="your_cloudinary_cloud_name"
CLOUDINARY_API_KEY="your_cloudinary_api_key"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"

# ------------------------------------------
# 8. Transactional Emails (Brevo / Sendinblue)
# ------------------------------------------
BREVO_API_KEY="xkeysib-your-brevo-api-key"
MAIL_FROM_EMAIL="contato@sinalizego.com.br"
MAIL_FROM_NAME="SinalizeGO Suporte"
ASAAS_MASTER_WALLET_ID="wal_master123"
