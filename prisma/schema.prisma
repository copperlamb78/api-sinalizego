generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// 1. A IDENTIDADE (Quem faz o login)
model User {
  id         String    @id @default(uuid())
  name       String
  email      String    @unique
  password   String
  phone      String
  role       Role      @default(CLIENT)

  refreshToken String?

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  isActive   Boolean   @default(true)
  disabledAt DateTime? // Corrigido de dateTime? para DateTime?

  companies         Company[] 
  appointments      Appointment[] 
  financialProfiles FinancialProfile[]
}

enum Role {
  CLIENT
  PROVIDER
  COMPANY_OWNER
  EMPLOYEE
  ADMIN
  SUPER_ADMIN
}

// 2. O NEGÓCIO (A Barbearia/Estúdio/Empresa)
model Company {
  id           String    @id @default(uuid())
  userId       String   
  businessName String
  slug         String    @unique
  whatsapp     String?   // Adicionado de volta o número público
  chairsCount  Int       @default(1)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  isActive     Boolean   @default(true)
  disabledAt   DateTime? // Corrigido de dateTime? para DateTime?

  providerType String
  district     String      
  street       String
  city         String
  state        String
  zipCode      String
  number       String

  logoPhoto    String?
  bannerPhoto  String?

  financialProfileId String?
  financialProfile   FinancialProfile? @relation(fields: [financialProfileId], references: [id])

  owner              User                @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  services           Service[]
  appointments       Appointment[]
  workingHours       WorkingHour[]
  scheduleExceptions ScheduleException[]
}

// 3. OS SERVIÇOS
model Service {
  id                 String    @id @default(uuid())
  companyId          String
  name               String
  description        String?
  durationMinutes    Int
  totalPrice         Float
  downPaymentPercent Int
  availableEmployers Int       @default(1)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  isActive           Boolean   @default(true)
  disabledAt         DateTime? 

  company            Company       @relation(fields: [companyId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  appointments       Appointment[]
}

// 4. OS AGENDAMENTOS
model Appointment {
  id              String     @id @default(uuid())
  companyId       String
  serviceId       String
  clientId        String
  appointmentDate DateTime  
  appointmentEndDate DateTime 
  status          ApptStatus @default(PENDING_PAYMENT)
  expiresAt       DateTime?
  pixTxId         String?    // transaction id do pix
  servicePrice    Float
  downPaymentAmount Float
  platformFeeAmount Float
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt // Adicionado para rastrear mudanças de status
  isActive        Boolean    @default(true)
  disabledAt      DateTime?  // Corrigido de dateTime? para DateTime?
  disabledBy      String?

  company         Company  @relation(fields: [companyId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  service         Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  client          User     @relation(fields: [clientId], references: [id], onDelete: Cascade, onUpdate: Cascade)
}

enum ApptStatus {
  PENDING_PAYMENT 
  CONFIRMED       
  COMPLETED       
  CANCELED        
}

// 5. AGENDA SEMANAL
model WorkingHour {
  id         String   @id @default(uuid())
  companyId  String
  dayOfWeek  Int      // 0 = Domingo, 1 = Segunda, 2 = Terça...
  startTime  String   // "09:00"
  endTime    String   // "18:00"
  isClosed   Boolean  @default(false) 

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  
  @@unique([companyId, dayOfWeek])
}

// 6. EXCEÇÕES E FERIADOS
model ScheduleException {
  id         String    @id @default(uuid())
  companyId  String
  date       DateTime
  isClosed   Boolean   @default(true) 
  
  startTime  String?  
  endTime    String?  

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  isActive   Boolean   @default(true)
  disabledAt DateTime? // Corrigido de dateTime? para DateTime?

  company    Company   @relation(fields: [companyId], references: [id], onDelete: Cascade, onUpdate: Cascade)
}

model FinancialProfile {
  id               String    @id @default(cuid())
  
  // Dados Básicos da Subconta
  name             String
  email            String
  cpfCnpj          String    @unique
  birthDate        DateTime? // Obrigatório apenas para PF (Pessoa Física)
  companyType      String?   // MEI, LIMITED, INDIVIDUAL, ASSOCIATION (Apenas para PJ)
  
  // Contato e Faturamento
  mobilePhone      String
  incomeValue      Float
  
  // Endereço
  address          String    // Logradouro
  addressNumber    String
  province         String    // Bairro
  postalCode       String
  
  // Retorno do Asaas
  walletId         String    @unique // ID da carteira gerada no Asaas
  asaasApiKey      String?   // Chave de API da subconta (útil para operações futuras)

  // Relacionamentos da sua Arquitetura
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  companies        Company[] 

  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}